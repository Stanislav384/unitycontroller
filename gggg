# Ми робимо функцію яка дасть можливість ВІДКРИТИ мені папку на компі.
# Без цієї дії - відкрити папку з фотками попросту НЕМОЖЛИВО. 
def chooseWorkdir():
    global workdir 
    workdir = QFileDialog.getExistingDirectory()

def filter(files, extensions):
    result = []
    for filename in files:
        for ext in extensions: 
            if filename.endswith(ext):
                result.append(filename)

    return result

def showFilenamesList():
    extensions = ['.jpg', '.jpeg', '.png', '.gif', '.bmp']
    chooseWorkdir()
    # os.listdir - це дія яка говорить компу "ВІДКРИЙ ПОСИЛАННЯ ЯКЕ ТОБІ ДАЛИ - 
    # І ВИТЯГНИ З ВІДТИ УСІ ФАЙЛИ"
    # Якщо не використовувати os.listdir - то ви шукаєте файли В ПОСИЛАННІ а не в папці!!!!
    filenames = filter(os.listdir(workdir), extensions)
    load_files.clear()
    for filename in filenames:
        load_files.addItem(filename)

btn_dir.clicked.connect(showFilenamesList)

