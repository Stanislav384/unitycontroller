# ТУТ ДАЛІ ВСІІІІ ДІЇ ЯКІ БУДУТЬ В ФОТОШОПІ. (ПОВОРОТИ, ФІЛЬТРИ І Т.Д)
class ImageProcessor():
    def __init__(self):
        self.image = None
        self.dir = None
        self.filename = None
        self.save_dir = "Modified/"
    
    # Під час завантаження ця дія буде запам'ятовувати шлях та ім'я файлу.
    def loadImage(self, filename):
        self.filename = filename 
        fullname = os.path.join(workdir, filename)
        self.image = Image.open(fullname)

    # Показати картинку у інтерфейсі за допомогою QPixmap.
    def showImage(self, path):
        lb_image.hide()
        pixmapimage = QPixmap(path)
        w, h = lb_image.width(), lb_image.height()
        pixmapimage = pixmapimage.scaled(w, h, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        lb_image.setPixmap(pixmapimage)
        lb_image.show()
    
    # Автозбереження редагованої фотографії. (Підстраховка\створення копії вибраної фотографії)
    def saveImage(self):
        # Створювати ТА зберігати КОПІЮ фотографії в ПІДПАПКУ.
        # path - це змінна в якій буде вказано В якому місці мені створити папку.
        # створюватись папка буде в ТІЙ ПАПЦІ з фотками яку ви відкривали.
        path = os.path.join(workdir, self.save_dir)
        # це перевірка ЯКЩО НЕМАЄ папки Modefied або НЕМАЄ посилання на папки взагалі
        if not os.path.exists(path) or os.path.isdir(path):
            os.mkdir(path)
        # Я створюю зміну яка буде створювати копію, використовуючи папку Modefied та оригінальну назву фотки.
        # Створюю копію.
        fullname = os.path.join(path, self.filename)
        self.image.save(fullname)
        
    def do_left(self):
        self.image = self.image.transpose(Image.ROTATE_90)
        self.saveImage()
        image_path = os.path.join(workdir, self.save_dir, self.filename)
        self.showImage(image_path)



